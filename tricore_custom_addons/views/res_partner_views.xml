<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_form_arabic_invoice_details" model="ir.ui.view">
        <field name="name">res.partner.form.arabic.invoice.details</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
             <xpath expr="/form/sheet/group/group/div" position="after">
                    <field name="district" placeholder="District"/>
            </xpath>
        </field>
    </record>
     <record id="view_partner_bank_form_inherit_iban" model="ir.ui.view">
        <field name="name">res.partner.bank.form.inherit.iban</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='account_number']" position="after">
                <field name="iban" placeholder="Enter IBAN"/>
            </xpath>
        </field>
    </record>
</odoo>
