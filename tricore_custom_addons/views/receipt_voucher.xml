<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="mx_receipt_voucher_form" model="ir.ui.view">
    <field name="name">mx.receipt.voucher.form</field>
    <field name="model">mx.receipt.voucher</field>
    <field name="inherit_id" ref="receipt_voucher.mx_receipt_voucher_form"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='account_id']" position="replace">
            <field name="account_id"
       context="{'no_account_hierarchy': True}" required="1" readonly="state in ['post', 'cancel']"  options="{'no_create': True, 'no_create_edit':True}"/>
        </xpath>
         <xpath expr="//field[@name='voucher_line_ids']/list[@name='voucher_lines']/field[@name='account_id']" position="replace">
              <field name="account_id" context="{'no_account_hierarchy': True}"  options="{'no_create': True, 'no_create_edit':True}"  string="Account"/>
         </xpath>
    </field>
    </record>
</odoo>