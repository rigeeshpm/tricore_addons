<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="paperformat_compact_header_delivery" model="report.paperformat">
            <field name="name">Compact Header for custom layouts Sale</field>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">25</field>
            <field name="margin_bottom">18</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">30</field>
            <field name="dpi">90</field>
    </record>
    <record id="stock.action_report_delivery" model="ir.actions.report">
        <field name="paperformat_id"
               ref="tricore_custom_addons.paperformat_compact_header_delivery"/>
    </record>
    <template id="report_delivery_document_custom"
          inherit_id="stock.report_delivery_document">
        <xpath expr="//t[@t-call='web.external_layout']"
               position="attributes">
             <attribute name="t-call">tricore_custom_addons.custom_external_layout_header</attribute>
        </xpath>
        <xpath expr="//div[@class='page']/h2" position="replace"/>
        <xpath expr="//t[@t-set='address']" position="replace"/>
        <xpath expr="//div[@id='informations']" position="replace">
            <t t-if="o.picking_type_code == 'internal'">
                 <h2 style="margin-top: 15px;">
                        <span t-out="o._get_deliveryslip_report_title()"/>
                        <span t-field="o.name">WH/OUT/0001</span>
                    </h2>
            </t>
            <!--            delivery return-->
            <table style="width:100%;
                              border-collapse:collapse;
                              table-layout:fixed;
                              margin-bottom:15px;
                              font-size:11pt;" t-if="o.picking_type_code == 'incoming' and o.return_id">
                    <tr>
                        <td style="border:1px solid #000; padding:5px;">
                            <strong>Delivery Return # <span t-field="o.name"/> </strong>
                        </td>
                        <td  style="border:1px solid black; padding:2px; vertical-align:top;"> <strong> Order: <span t-field="o.return_id.origin" class="m-0">S0001</span></strong></td>
                        <td  style="border:1px solid black; padding:2px; vertical-align:top;"><strong>Date: <span t-field="o.scheduled_date" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/> </strong></td>
                    </tr>
            </table>
            <!--            for receipt-->
            <table style="width:100%;
                              border-collapse:collapse;
                              table-layout:fixed;
                              margin-bottom:15px;
                              font-size:11pt;" t-if="o.picking_type_code == 'incoming' and not o.return_id">
                    <tr>
                        <td style="border:1px solid #000; padding:5px;">
                                <strong>RECEIPT # <span t-field="o.name"/> </strong>
                        </td>
                        <td  style="border:1px solid black; padding:2px; vertical-align:top;"> <strong> Order: <span t-field="o.origin" class="m-0">S0001</span></strong></td>
                        <td  style="border:1px solid black; padding:2px; vertical-align:top;"><strong>Date: <span t-field="o.scheduled_date" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/> </strong></td>
                    </tr>
            </table>
            <!--            for receipt return-->
            <table style="width:100%;
                              border-collapse:collapse;
                              table-layout:fixed;
                              margin-bottom:15px;
                              font-size:11pt;" t-if="o.picking_type_code == 'outgoing' and o.return_id">
                    <tr>
                        <td style="border:1px solid #000; padding:5px;">
                                <strong>MRN Return # <span t-field="o.name"/> </strong>
                        </td>
                        <td  style="border:1px solid black; padding:2px; vertical-align:top;"> <strong> Order: <span t-field="o.return_id.origin" class="m-0">S0001</span></strong></td>
                        <td  style="border:1px solid black; padding:2px; vertical-align:top;"><strong>Date: <span t-field="o.scheduled_date" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/> </strong></td>
                    </tr>
            </table>
            <!--            for receipt, receipt return and delivery return-->
            <table t-if="o.picking_type_code == 'incoming' or (o.picking_type_code == 'outgoing' and o.return_id)">
                    <tr>
                         <td>
                             <strong>From</strong>
                             <div t-field="partner.commercial_partner_id"
                                     t-options='{"widget": "contact", "fields": ["address", "name", "phone", "vat"], "no_marker": True, "phone_icons": True}'/>
                         </td>
                         <td>
                              <strong>Warehouse Address</strong>
                            <div t-field="o.picking_type_id.warehouse_id.partner_id"
                                t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                         </td>
                    </tr>
            </table>
            <!--            for delivery note-->
            <table t-if="o.picking_type_code == 'outgoing' and not o.return_id" style="width:100%;
                          border-collapse:collapse;
                          table-layout:fixed;
                          margin-bottom:15px;
                          font-size:11pt;">
                <colgroup>
                    <col style="width:35%;"/>
                    <col style="width:35%;"/>
                    <col style="width:30%;"/>
                </colgroup>
                <!-- FIRST ROW: All cells have borders -->
                <tr>
                    <td style="border:1px solid #000; padding:5px;">
                            <strong>DELIVERY NOTES</strong>
                    </td>
                    <td style="border:1px solid #000; padding:5px;">
                        <strong>Doc # <span t-field="o.name"/> </strong>
                    </td>
                    <td style="border:1px solid #000; padding:5px;">
                        <strong>Date <span t-field="o.scheduled_date" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/> </strong>
                    </td>
                </tr>
                <tr>
                    <td style="border:1px solid black; padding:2px; vertical-align:top;">
                                <table class="table-borderless" style="width: 100%; border-collapse: collapse; border: none !important;">
                                    <tr style="border: none !important;">
                                        <td style="border: none !important;min-width:60px !important;"> Bill To:  </td>
                                        <td style="border: none !important;white-space: normal;word-wrap: break-word;overflow-wrap: break-word;">
                                            <span t-field="o.partner_id"/> </td>
                                    </tr>
                                    <tr style="border: none !important;">
                                        <td style="border: none !important;"></td>
                                        <td style="border: none !important;overflow-wrap:anywhere;"> <span t-field="o.partner_id.name_ar"/> </td>
                                    </tr>
                                    <tr style="border: none !important;">
                                        <td style="border: none !important;">Attn: </td>
                                        <td style="border: none !important;overflow-wrap:anywhere;"><span t-field="o.user_id"/></td>
                                    </tr>
                                    <tr style="border: none !important;">
                                        <td style="border: none !important;">VAT:  </td>
                                        <td style="border: none !important;"><span t-field="o.partner_id.vat"/></td>
                                    </tr>
                                    <tr style="border: none !important;">
                                        <td style="border: none !important;"></td>
                                        <td style="border: none !important;"><t t-out="o.partner_id.translate_to_arabic_digits(o.partner_id.vat)" /></td>
                                    </tr>
                                </table>
                    </td>
                    <td style="border:1px solid black; padding:2px; vertical-align:top;">
                            <span>LPO No.: </span><span t-field="o.sale_id.client_order_ref"/> <br/>
                            <span>Delivery Term:  </span><span t-field="o.sale_id.incoterm.code"/> <br/>
                            <span>Delivery Location:
                                <span t-field="o.incoterm_location"/>
                            </span><br/>
                    </td>
                    <td style="border:1px solid black; padding:2px; vertical-align:top;">
                            <span>Project: <span t-field="o.sale_id.project_name"/> </span><br/>
                            <span>Currency: <span t-field="o.company_id.currency_id"/></span><br/>
                            <span>Sales Person: <span t-field="o.sale_id.salesman"/> </span>
                    </td>
                </tr>
            </table>
        </xpath>
        <xpath expr="//table[@name='stock_move_line_table']"
               position="attributes">
            <attribute name="class" add="table table-sm delivery-move-table" separator=" "/>
        </xpath>
        <!--remove the  delivery lines table (stock.move.line)-->
        <xpath expr="//table[@name='stock_move_line_table']" position="replace"/>
        <!--replace the stock_move_table        -->
        <xpath expr="//table[@name='stock_move_table']" position="replace">
            <table class="table table-sm delivery-move-table"  name="stock_move_table">
                <thead style="display: table-header-group">
                    <tr>
                        <t t-set="line_index" t-value="0"/>
                        <th name="th_si_no"
                            style="text-align:center;width: 6% !important; min-width: 7% !important; max-width: 7% !important; white-space: nowrap;"
                            t-attf-class="{{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                            <span>Sr No.</span>
                        </th>
                        <th name="th_name"
                            style="white-space: nowrap;width: 150px !important; min-width: 150px !important; max-width: 150px !important; "
                            t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                            <span>Item Code</span>
                        </th>
                        <th name="th_sm_product" style="text-align:left;min-width:40% !important;">Description</th>
                        <th name="th_sm_quantity" style="width:75px !important;text-align:center">Quantity</th>
                        <th name="th_uom" style="text-align:center" >UoM</th>
                        <th name="th_remarks" style="white-space: nowrap;width: 150px !important; min-width: 150px !important; max-width: 150px !important;">
                            Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="lines" t-value="o.move_ids.filtered(lambda x: x.product_uom_qty)"/>
                    <tr t-foreach="lines" t-as="move">
                        <td name="td_index" style="text-align:center;">
                            <t t-set="line_index" t-value="line_index+1"/>
                            <span t-out="line_index"/>
                        </td>
                        <td name="td_name" style="text-align:left;">
                            <span t-out="move.product_id.default_code"/>
                        </td>
                        <td name="td_description" style="text-align:left">
                            <span t-field="move.product_id">Customizable Desk</span>
                            <p t-if="move.description_picking and move.description_picking != move.product_id.name and move._get_report_description_picking()">
                                <span t-out="move._get_report_description_picking()" t-options="{'widget': 'text'}">Description on transfer</span>
                            </p>
                        </td>
                        <td name="o_td_quantity" style="text-align:center">
                            <span t-out="format_number(move.product_uom_qty)" class="text-nowrap">3.00</span>
                        </td>
                        <td name="td_uom" style="text-align:center">
                            <span t-field="move.uom_id">units</span>
                        </td>
                        <td name="td_remark" style="text-align:left;">
                            <span t-field="move.remarks"/>
                        </td>
                    </tr>
                </tbody>
            </table>
        </xpath>
        <!--        remove backorder table-->
        <xpath expr="//t[@t-set='backorders']" position="replace">
            <t t-set="backorders"
               t-value="false"/>
        </xpath>
        <!--replaces the signature section-->
        <xpath expr="//div[@name='signature']"
           position="replace">
            <div style="width:100%; margin-top:20px;">
                <!-- Prepared By and Received By -->
                <table style="width:100%; border-collapse:collapse;
                              table-layout:fixed; font-size:10pt;">
                    <colgroup>
                        <col style="width:55%;"/>
                        <col style="width:45%;"/>
                    </colgroup>
                    <tr>
                        <!-- Prepared By -->
                        <td style="border:none; vertical-align:top;
                                   padding:10px;">
                            <div style="width:200px;text-align:left;margin-top:100px; border-top:1px solid black">
                                <strong>
                                    Prepared By
                                </strong>
                            </div>
                        </td>
                        <!-- Received By -->
                        <td style="border:1px solid #000;
                                   padding:7px; vertical-align:top;">
                            <strong>
                                Received By :
                            </strong>
                            <table style="width:100%;
                                          border-collapse:collapse;">
                                <colgroup>
                                    <col style="width:25%;"/>
                                    <col style="width:10%;"/>
                                    <col style="width:65%;"/>
                                </colgroup>
                                <tr>
                                    <td style="border:none; padding:4px;">
                                        Name
                                    </td>
                                    <td style="border:none; padding:4px;">
                                        :
                                    </td>
                                    <td style="border-bottom:1px solid #000;
                                               padding:4px;">
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border:none; padding:4px;">
                                        Tel
                                    </td>
                                    <td style="border:none; padding:4px;">
                                        :
                                    </td>
                                    <td style="border-bottom:1px solid #000;
                                               padding:4px;">
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border:none; padding:4px;">
                                        Signature
                                    </td>
                                    <td style="border:none; padding:4px;">
                                        :
                                    </td>
                                    <td style="border-bottom:1px solid #000;
                                               padding:4px;">
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border:none; padding:4px;">
                                        Date
                                    </td>
                                    <td style="border:none; padding:4px;">
                                        :
                                    </td>
                                    <td style="border-bottom:1px solid #000;
                                               padding:4px;">
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
                <!-- Terms and Conditions -->
                <div style="margin-top:25px; font-size:10pt;">
                    <strong style="font-size:12pt;">
                        Terms &amp; Conditions
                    </strong>
                    <span t-field="o.note"/>
                </div>
                <!-- Chemical Goods Notice -->
                <div style="margin-top:25px;
                            color:red;
                            font-size:15pt;">
                    Chemical goods once delivered or sold cannot be returned
                    or replaced
                </div>
            </div>
        </xpath>
    </template>
</odoo>
