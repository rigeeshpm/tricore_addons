<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="paperformat_compact_header_sale" model="report.paperformat">
            <field name="name">Compact Header for custom layouts Sale</field>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">25</field>
            <field name="margin_bottom">15</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">30</field>
            <field name="dpi">90</field>
    </record>
    <record id="sale_pdf_quote_builder.action_report_saleorder_raw" model="ir.actions.report">
        <field name="paperformat_id"
               ref="tricore_custom_addons.paperformat_compact_header_sale"/>
    </record>
    <template id="report_saleorder_custom_layout"
              inherit_id="sale.report_saleorder_document">
        <xpath expr="//t[@t-call='web.external_layout']"
               position="attributes">
             <attribute name="t-call">tricore_custom_addons.custom_external_layout_header</attribute>
        </xpath>
        <xpath expr="//div[@id='informations']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//t[@t-set='layout_document_title']" position="replace"/>
        <!-- Replace the quotation address variable with a 6-row, 4-column details table. -->
        <xpath expr="//t[@t-set='address']" position="replace">
            <t t-set="address">
                <table class="table table-sm table-bordered"
                       style="width:100%; table-layout:fixed; border-collapse:collapse;
                              margin:0; padding:0; font-size:10pt;">
                        <tbody>
                            <tr>
                                <td colspan="2"
                                    style="text-align:left; background:#eeeeee; padding:5px;">
                                    <h6><b>QUOTATION : #</b><span t-out="doc.name"/></h6>

                                </td>
                                <td colspan="2" style="text-align:left; background:#eeeeee; padding:5px;">
                                    <h6>Date : <span t-out="doc.date_order" t-options='{"widget": "date"}'/></h6>
                                </td>
                            </tr>
                            <tr>
                                <td style="width:17%;">Customer</td>
                                <td style="width:33%;"><span t-field="doc.partner_id.name"/></td>
                                <td>Address</td>
                                <td>
                                    <t t-set="shipping" t-value="doc.partner_shipping_id"/>
                                    <!-- Address Fields -->
                                        <span t-if="shipping.street">
                                            <span t-field="shipping.street"/>
                                        </span><br/>
                                        <span t-if="shipping.street2">
                                            <span t-field="shipping.street2"/>
                                        </span>
                                        <span t-if="shipping.x_studio_building">
                                            ,<span t-field="shipping.x_studio_building"/>
                                        </span>
                                        <span t-if="shipping.x_studio_secondary">
                                            ,<span t-field="shipping.x_studio_secondary"/>
                                        </span>
                                        <br/>
                                        <span t-if="shipping.city">
                                            <span t-field="shipping.city"/>
                                        </span>
                                        <span t-if="shipping.state_id">
                                            , <span t-field="shipping.state_id"/>
                                        </span>
                                        <span>
                                            , <span t-if="shipping.zip"
                                                  t-field="shipping.zip"/>
                                        </span>
                                        <div t-if="shipping.country_id">
                                            <span t-field="shipping.country_id"/>
                                        </div>
                                </td>
                            </tr>
                            <tr>
                                <td>Kind Attn</td>
                                <td><span t-field="doc.user_id"/>
                                </td>
                                <td>Validity</td>
                                <td><span t-field="doc.validity_date"/></td>
                            </tr>
                            <tr>
                                <td>TRN</td>
                                <td> <span t-field="doc.partner_id.vat"/>
                                </td>
                                <td>ETA</td>
                                <td>
                                    <span t-field="doc.expected_date" t-options='{"widget": "date"}'/>
                                </td>
                            </tr>
                            <tr>
                                <td>Project Location</td>
                                <td> <span t-field="doc.project_location"/>
                                </td>
                                <td>Delivery Terms</td>
                                <td>
                                    <span t-field="doc.incoterm"/>
                                </td>
                            </tr>
                            <tr>
                                <td>Project Name</td>
                                <td> <span t-field="doc.project_name"/>
                                </td>
                                <td>Name</td>
                                <td>
                                    <span t-field="doc.user_id"/>
                                </td>
                            </tr>
                        </tbody>
                </table>
            </t>
        </xpath>
        <!-- ..........sale order line table start................      -->
        <!--        no need to show tax column. so we set hide_taxes_details=True-->
        <xpath expr="//t[@t-set='hide_taxes_details']" position="replace">
               <t t-set="hide_taxes_details" t-value="True"/>
        </xpath>
        <xpath expr="//t[@t-set='display_discount']" position="replace">
               <t t-set="display_discount" t-value="False"/>
        </xpath>
        <!-- Add borders to every header and data cell -->
        <xpath expr="//table[hasclass('o_main_table')]" position="attributes">
           <attribute name="class" add="sales-lines-cell-borders" separator=" "/>
        </xpath>
        <!--  replace table header      -->
        <xpath expr="//table[hasclass('o_main_table')]/thead"
               position="replace">
                <thead style="display: table-row-group">
                    <tr>
                        <th name="th_si_no"
                            style="width: 5% !important; min-width: 5% !important; max-width: 5% !important; white-space: nowrap;"
                            t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                            <span>#</span>
                            <t t-set="line_index" t-value="0"/>
                        </th>
                        <th name="th_model_id" style="text-align: left; min-width: 150px !important;width: 150px !important; " class="text-start" aria-label="Model No">
                            <span>Code</span>
                        </th>
                        <th name="th_description" style="text-align: left; min-width: 30% !important; "  aria-label="Description">
                            <span>Description</span>
                        </th>
                        <th name="th_quantity" style="text-align: left; max-width: 60px !important; " class="text-start text-nowrap" aria-label="Quantity">
                            Qty/Unit
                        </th>
                        <th name="th_remarks" class="text-start text-nowrap" style="width: 100px !important;
                                    min-width: 100px !important;
                                    white-space: normal !important;
                                    overflow-wrap: break-word;">
                            Remarks
                        </th>
                         <th name="th_priceunit" class="text-end text-nowrap">
                            Unit Price
                        </th>
                        <th name="th_subtotal" class="text-end">
                                        <span>Total</span>
                         </th>
                    </tr>
                </thead>
        </xpath>
        <!-- si no column will be added if "show line numbers" enabled in settings-->
        <xpath expr="//td[@name='td_product_name']" position="before">
            <td name="td_model" style="text-align:left">
                 <span t-field="line.product_id.default_code" class="text-nowrap"></span>
            </td>
        </xpath>
        <xpath expr="//td[@name='td_product_priceunit']" position="before">
            <td name="td_remarks" style="text-align:left">
                <span t-field="line.remarks" />
            </td>
        </xpath>
        <!-- ..........sale order line table end................      -->
        <!-- Replace the standard quotation totals section -->
        <xpath expr="//div[@id='total']" position="replace">
            <t t-set="gross_total"
               t-value="sum(line.price_unit * line.product_uom_qty for line in doc.order_line if not line.display_type)"/>
            <t t-set="discount_amount"
               t-value="sum(line.price_unit * line.product_uom_qty * line.discount / 100.0 for line in doc.order_line if not line.display_type)"/>
            <table style="width:100%; border-collapse:collapse;
                          border:1px solid black; font-size:10pt;
                          margin-top:5px;">
                <tr>
                    <!-- LEFT SECTION -->
                    <td style="width:66%; vertical-align:top;
                               padding:0; border:1px solid black;">
                        <!-- Amount in words and remarks -->
                        <div style="padding:8px 10px; min-height:145px;">
                            <strong>Total Amount In Words :</strong>
                            <div style="margin-left:30%; margin-top:3px;
                                        font-weight:bold;">
                                <span t-out="doc.currency_id.amount_to_text(doc.amount_total)"/>
                            </div>
                            <div style="margin-top:15px;">
                                <strong>Noted/Remarks :-</strong>
                            </div>
                            <div style="margin-left:30%; margin-top:3px;">
                                <span t-field="doc.remark"/>
                            </div>
                        </div>
                        <!-- Payment Terms -->
                        <div style="border-top:1px solid black;
                                    padding:10px; min-height:100px;">
                            <strong>Payment Term</strong>
                            <div style="margin-left:30%; margin-top:3px;">
                                <span t-field="doc.payment_term_id.name"/>
                            </div>
                        </div>
                    </td>
                    <td style="width:34%; vertical-align:top;
                               padding:0;">
                        <table style="width:100%; border-collapse:collapse;
                                      font-size:10pt;">
                            <tr>
                                <td style="width:60%; padding:8px;
                                           border:1px solid black;">
                                    Grand Total
                                </td>
                                <td style="width:40%; padding:8px;
                                           text-align:right;
                                           border:1px solid black;">
                                    <span t-out="gross_total"
                                          t-options='{"widget":"monetary","display_currency":doc.currency_id}'/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:8px; border:1px solid black;">
                                    Discount
                                </td>
                                <td style="padding:8px; text-align:right;
                                           border:1px solid black;">
                                    <span t-out="discount_amount"
                                          t-options='{"widget":"monetary","display_currency":doc.currency_id}'/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:8px; border:1px solid black;">
                                    Taxable Value
                                </td>
                                <td style="padding:8px; text-align:right;
                                           border:1px solid black;">
                                    <span t-field="doc.amount_untaxed"
                                          t-options='{"widget":"monetary","display_currency":doc.currency_id}'/>
                                </td>
                            </tr>

                            <tr>
                                <td style="padding:8px; border:1px solid black;">
                                    VAT
                                    <span t-out="'%.0f' % (doc.amount_tax / doc.amount_untaxed * 100)"
                                          t-if="doc.amount_untaxed"/>
                                    <span t-if="not doc.amount_untaxed"> </span>%
                                </td>
                                <td style="padding:8px; text-align:right;
                                           border:1px solid black;">
                                    <span t-field="doc.amount_tax"
                                          t-options='{"widget":"monetary","display_currency":doc.currency_id}'/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:10px; font-weight:bold;
                                           border:1px solid black;">
                                    Grand Total
                                </td>
                                <td style="padding:10px; text-align:right;
                                           font-weight:bold;
                                           border:1px solid black;">
                                    <span t-field="doc.amount_total"
                                          t-options='{"widget":"monetary","display_currency":doc.currency_id}'/>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </xpath>
        <!--        replace signature,terms and conditions,payment term from its original position-->
        <xpath expr="//div[@name='signature']" position="replace"/>
        <xpath expr="//span[@name='order_note']" position="replace"/>
        <xpath expr="//p[@t-if='not is_html_empty(doc.payment_term_id.note)']" position="replace"/>
        <!-- A dedicated final page. display terms and conditions from 'note' field -->
        <xpath expr="//div[@class='page']" position="after">
        <div class="page" style="page-break-before: always; font-size: 10pt; line-height: 1.5;">
            <h5 style="text-align: left; margin-bottom: 18px;">
                TERMS &amp; CONDITIONS
            </h5>
            <p t-field="doc.note" class="mt-4"/>
        </div>
        </xpath>
    </template>
</odoo>
