<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="paperformat_compact_header_invoice" model="report.paperformat">
            <field name="name">Compact Header for custom layouts Invoice</field>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">25</field>
            <field name="margin_bottom">15</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">30</field>
            <field name="dpi">90</field>
    </record>
    <template id="report_invoice_document" inherit_id="account.report_invoice_document" primary="True">
        <xpath expr="//t[@t-call='web.external_layout']"
               position="attributes">
             <attribute name="t-call">tricore_custom_addons.custom_external_layout_header</attribute>
        </xpath>
        <xpath expr="//t[@t-set='layout_document_title']" position="replace"/>
        <xpath expr="//t[@t-set='address']" position="replace"/>

         <xpath expr="//div[@id='informations']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//div[@id='informations']" position="before">
                 <t t-set="partner_ar" t-value="o.partner_id.with_context(lang='ar_001')"/>
            <t t-set="partner_en" t-value="o.partner_id.with_context(lang='en_US')"/>
                <t t-if="o and o._name == 'account.move'">
                    <table class="table table-sm table-bordered"
                           style="width:100%; max-width:100%; table-layout:fixed;margin-top:0px !important;margin-bottom:0px !important;
                                    border-collapse:collapse; margin:0 !important;
                                    padding:0 !important; font-size:10pt;text-overflow:wrap">
                            <colgroup>
                                <col style="width:8%;"/>
                                <col style="width:17%;"/>
                                <col style="width:10%;"/>
                                <col style="width:15%;"/>
                                <col style="width:15%;"/>
                                <col style="width:10%;"/>
                                <col style="width:17%;"/>
                                <col style="width:8%;"/>
                            </colgroup>
                        <thead>
                            <tr>
                                <th colspan="4"
                                    style="text-align:left; background:#eeeeee; padding:5px;">
                                    <h6><b>Tax Invoice : #</b><span t-out="o.name"/></h6>

                                </th>
                                <th colspan="4" style="text-align:left; background:#eeeeee; padding:5px;">
                                    <h6>Date :<span t-out="o.invoice_date"/></h6>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td style="padding:4px;">
                                    Name
                                </td>
                                <td colspan="3"
                                    style="padding:4px; overflow-wrap:anywhere;">
                                    <span t-out="partner_en.name"/>
                                </td>

                                <td colspan="3" style="padding:4px; direction:rtl;
                                           text-align:right; overflow-wrap:anywhere;">
                                    <span><span t-field="o.partner_id.name_ar"/> </span>
                                </td>
                                <td
                                    style="padding:4px; direction:rtl;
                                           text-align:right;">
                                    اسم
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:4px;">
                                    Street
                                </td>
                                <td style="padding:4px; overflow-wrap:anywhere;">
                                    <span t-out="partner_en.street"/>
                                </td>
                                <td style="padding:4px; overflow-wrap:anywhere;">
                                   Building No.
                                </td>
                                <td style="padding:4px; overflow-wrap:anywhere;">
                                    <span t-field="partner_en.x_studio_building"/>
                                </td>

                                <td style="padding:4px; direction:rtl;
                                           text-align:right; overflow-wrap:anywhere;">
                                    <span t-field="partner_en.x_studio_building"/>
                                </td>

                                <td style="padding:4px; direction:rtl;
                                           text-align:right; overflow-wrap:anywhere;">
                                    رقم المبنى
                                </td>
                                <td style="padding:4px; direction:rtl;
                                           text-align:right; overflow-wrap:anywhere;">
                                    <span t-out="partner_ar.street"/>
                                </td>
                                <td style="padding:4px; direction:rtl;
                                           text-align:right; overflow-wrap:anywhere;">
                                    اسم الشارع
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:4px;">
                                    Addi No.
                                </td>
                                <td style="padding:4px; overflow-wrap:anywhere;">
                                    <span t-out="partner_en.x_studio_secondary"/>
                                </td>
                                <td style="padding:4px; overflow-wrap:anywhere;">
                                   City
                                </td>
                                <td style="padding:4px; overflow-wrap:anywhere;">
                                    <span t-out="partner_en.city"/>
                                </td>
                                <td style="padding:4px; direction:rtl;
                                           text-align:right; overflow-wrap:anywhere;">
                                    <span t-out="partner_ar.city"/>
                                </td>
                                <td style="padding:4px; direction:rtl;
                                           text-align:right; overflow-wrap:anywhere;">
                                    مدينة
                                </td>
                                <td style="padding:4px; direction:rtl;
                                           text-align:right; overflow-wrap:anywhere;">
                                        <span t-out="partner_ar.x_studio_secondary"/>
                                </td>
                                <td style="padding:4px; direction:rtl;
                                           text-align:right; overflow-wrap:anywhere;">
                                    رقم إضافي
                                </td>
                            </tr>
<!--                        4th row of the customer address-->
                            <tr>
                                <td style="padding:4px;">
                                    District
                                </td>

                                <td style="padding:4px; overflow-wrap:anywhere;">
                                    <span t-field="o.partner_id.street2"/>
                                </td>

                                <td style="padding:4px; overflow-wrap:anywhere;">
                                   Zip code
                                </td>

                                <td style="padding:4px; overflow-wrap:anywhere;">
                                    <span t-field="o.partner_id.zip"/>
                                </td>

                                <td style="padding:4px; direction:rtl;
                                           text-align:right; overflow-wrap:anywhere;">
                                    <span t-field="o.partner_id.zip"/>
                                </td>
                                <td style="padding:4px; direction:rtl;
                                           text-align:right; overflow-wrap:anywhere;">
                                    الرمز البريدي
                                </td>
                                <td style="padding:4px; direction:rtl;
                                           text-align:right; overflow-wrap:anywhere;">
                                    <span t-field="partner_ar.street2"/>

                                </td>
                                <td style="padding:4px; direction:rtl;
                                           text-align:right; overflow-wrap:anywhere;">
                                    يصرف
                                </td>
                            </tr>
                            <tr>
                                <td style=" padding:4px;">
                                    State
                                </td>
                                <td style="padding:4px; overflow-wrap:anywhere;">
                                    <span t-out="partner_en.state_id.name"/>
                                </td>
                                <td style="padding:4px; overflow-wrap:anywhere;">
                                   Country
                                </td>
                                <td style="padding:4px; overflow-wrap:anywhere;">
                                    <span t-field="partner_en.country_id.name"/>
                                </td>
                                <td style="padding:4px; direction:rtl;
                                           text-align:right; overflow-wrap:anywhere;">
                                    <span t-out="partner_ar.country_id.name"/>
                                </td>
                                <td style="padding:4px; direction:rtl;
                                           text-align:right; overflow-wrap:anywhere;">
                                    دولة
                                </td>
                                <td style="padding:4px; direction:rtl;
                                           text-align:right; overflow-wrap:anywhere;">
                                    <span t-out="partner_ar.state_id.name"/>
                                </td>
                                <td style="padding:4px; direction:rtl;
                                           text-align:right; overflow-wrap:anywhere;">
                                    ولاية
                                </td>
                            </tr>
                            <!--  6th row of the customer address-->
                            <tr>
                                <td style="padding:4px;">
                                    VAT No.
                                </td>
                                <td style="padding:4px; overflow-wrap:anywhere;">
                                    <span t-field="o.partner_id.vat"/>
                                </td>

                                <td style="padding:4px; overflow-wrap:anywhere;">
                                   Region
                                </td>
                                <td style="padding:4px; overflow-wrap:anywhere;">
                                    <t t-out="o.get_invoice_region()"/>
                                </td>
                                <td style="padding:4px; direction:rtl;
                                           text-align:right; overflow-wrap:anywhere;">
                                     <t t-out="o.get_invoice_region()"/>
                                </td>
                                <td style="padding:4px; direction:rtl;
                                           text-align:right; overflow-wrap:anywhere;">
                                   منطقة
                                </td>
                                <td style="padding:4px; direction:rtl;
                                           text-align:right; overflow-wrap:anywhere;">
                                    <t t-out="o.partner_id.translate_to_arabic_digits(o.partner_id.vat)" />
                                </td>
                                <td style="padding:4px; direction:rtl;
                                           text-align:right; overflow-wrap:anywhere;">
                                    رقم ضريبة
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </t>
                <!-- Preserve the standard address for all other reports -->
                <t t-else="">
                    <t t-out="address or None"/>
                </t>
        </xpath>
        <xpath expr="//div[@id='informations']" position="after">
            <t t-set="sale_orders" t-value="o.invoice_line_ids.sale_line_ids.order_id"/>
            <t t-set="pickings" t-value="sale_orders.picking_ids.filtered(lambda p: p.state == 'done')"/>
            <div class="row"
                 style="width:100%; margin:0; padding:0;">
                <table class="table table-sm table-bordered"
                       style="width:100%; table-layout:fixed;margin-top:10px !important;margin-bottom:0px !important;
                              border-collapse:collapse; font-size:10pt;">
                    <thead>
                        <tr>
                            <th>Contract / PO No.</th>
                            <th>Project</th>
                            <th colspan="2">Payment Terms</th>
                            <th>L-Delivery Notes</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr style="min-height:50px;">
                            <td>
                                <t t-if="sale_orders">
                                    <t t-out="sale_orders[0].client_order_ref"/>
                                </t>
                            </td>
                            <td>
<!--                                <span t-field="o.project_id"/>-->
                            </td>
                            <td colspan="2">
                                <span t-field="o.invoice_payment_term_id"/>
                            </td>
                            <td>
                                 <t t-if="pickings">
                                    <t t-out="pickings[0].name"/>
                                </t>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </xpath>
          <!-- Remove the default payment terms section -->
        <xpath expr="//div[@id='payment_term']" position="replace">
            <t t-set="payment_term" t-value="False"/>
        </xpath>
        <xpath expr="//table[@name='invoice_line_table']"
               position="attributes">
            <t t-set="primary_color" t-value="o.company_id.primary_color or '#000000'"/>
            <attribute name="class" add="table table-sm invoice-lines-cell-borders" separator=" "/>
        </xpath>
        <xpath expr="//table[@name='invoice_line_table']" position="before">
                <style>
                    /* Description - maximum available width */
                    table.invoice-lines-cell-borders th[name='th_description'],
                    table.invoice-lines-cell-borders td[name='account_invoice_line_name'] {
                        width: 40% !important;
                        min-width: 0 !important;
                        white-space: normal !important;
                        overflow-wrap: break-word;
                    }
                    * index */
                    table.invoice-lines-cell-borders th[name='th_si_no'],
                    table.invoice-lines-cell-borders td[name='td_si_no'] {
                        max-width:10px !important;
                    }
                    * index */
                    table.invoice-lines-cell-borders th[name='th_name'],
                    table.invoice-lines-cell-borders td[name='product_name'] {
                        width: 200px !important;
                        min-width: 0 !important;
                        white-space: normal !important;
                        overflow-wrap: break-word;
                    }
                    /* Quantity */
                    table.invoice-lines-cell-borders th[name='th_quantity'],
                    table.invoice-lines-cell-borders td[name='td_quantity'] {
                        width: 6% !important;
                        min-width: 0 !important;
                        max-width: 6% !important;
                        white-space: nowrap !important;
                    }

                    /* Unit Price */
                    table.invoice-lines-cell-borders th[name='th_priceunit'],
                    table.invoice-lines-cell-borders td[name='td_price_unit'] {
                        width: 8% !important;
                    }

                    /* Taxes */
                    table.invoice-lines-cell-borders th[name='th_vat_amount'],
                    table.invoice-lines-cell-borders td[name='td_vat_amount'] {
                        width: 8% !important;
                    }
                    /* Taxes */
                    table.invoice-lines-cell-borders th[name='th_subtotal
                    table.invoice-lines-cell-borders td[name='td_subtotal'] {
                        width: 10% !important;
                    }
                    /* Amount / Net Amount */
                    table.invoice-lines-cell-borders th[name='th_net_amount'],
                    table.invoice-lines-cell-borders td[name='td_net_amount'] {
                        width: 10% !important;
                    }
                </style>
        </xpath>
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_si_no" style="width: 5% !important; min-width: 5% !important; max-width: 5% !important; white-space: nowrap;"
                t-attf-class="text-start{{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span>#</span>
                <t t-set="line_index" t-value="0"/>
            </th>
            <th name="th_name"
                style="white-space: nowrap;"
                t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span>Item</span>
            </th>
        </xpath>
        <xpath expr="//td[@name='account_invoice_line_name']" position="before">
            <td name="td_si_no" t-att-style="padding_style">
                <t t-set="line_index" t-value="line_index+1"/>
                <t t-out="line_index"/>
            </td>
            <td name="product_name">
             <span  t-field="line.product_id.name"/>
            </td>
        </xpath>
        <xpath expr="//th[@name='th_discount']" position="replace"/>
        <xpath expr="//td[@name='td_discount']" position="replace"/>
        <xpath expr="//th[@name='th_quantity']" position="replace">
            <th name="th_quantity" class="text-end" style="width: 6% !important;
                            min-width: 0 !important;
                            max-width: 6% !important;
                            white-space: nowrap !important;">
                <span>Qty/Unit</span>
            </th>
        </xpath>
<!--        <xpath expr="//th[@name='th_description']" position="after">-->
<!--            <th name="th_unit"-->
<!--                style="white-space: nowrap;"-->
<!--                t-attf-class="text-start{{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">-->
<!--                <span>Unit</span>-->
<!--            </th>-->
<!--        </xpath>-->
<!--        <xpath expr="//td[@name='account_invoice_line_name']" position="after">-->
<!--            <td name="item_unit" t-att-style="padding_style">-->
<!--                <span  t-field="line.product_id.uom_id.name"/>-->
<!--            </td>-->
<!--        </xpath>-->
        <!--       replace subtotal column with net amount-->
         <xpath expr="//th[@name='th_subtotal']" position="replace">
             <th name="th_net_amount" class="text-end">
                  <span>Net Amount</span>
            </th>
         </xpath>
        <xpath expr="//td[@name='td_subtotal']" position="replace">
            <td name="td_net_amount">
                 <span t-field="line.price_total"
                  t-options="{'widget': 'monetary',
                              'display_currency':o.currency_id}"/>
            </td>
        </xpath>
<!--        sub total , tax amount-->
        <xpath expr="//th[@name='th_taxes']" position="replace">
            <th name="th_subtotal" class="text-end">
                  <span>Subtotal</span>
            </th>
                <th name="th_taxes" t-if="display_taxes" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                    <span>VAT 15%</span>
                </th>
        </xpath>
         <xpath expr="//td[@name='td_taxes']" position="replace">
             <td name="td_subtotal" class="text-end o_price_total">
                 <span t-if="not hide_prices and o.document_tax_mode == 'tax_excluded'" class="text-nowrap" t-field="line.price_subtotal">27.00</span>
                 <span t-if="not hide_prices and o.document_tax_mode == 'tax_included'" class="text-nowrap" t-field="line.price_total">31.05</span>
             </td>
             <td name="td_taxes" t-if="display_taxes"
                  t-attf-class="text-end text-nowrap {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }} {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}">
                  <span class="text-nowrap"
                      t-field="line.l10n_gcc_invoice_tax_amount"
                      t-options="{'widget': 'monetary',
                                  'display_currency': o.currency_id}"/>
             </td>
         </xpath>
        <!-- Add summary table below invoice lines -->
        <xpath expr="//table[@name='invoice_line_table']" position="after">
            <!-- Gross Amount Before Discount -->
            <t t-set="gross_amount"
               t-value="sum(line.price_unit*line.quantity for line in o.invoice_line_ids)"/>


            <!-- Total Discount -->
            <t t-set="total_discount"
               t-value="sum(line.price_unit*line.quantity*line.discount/100 for line in o.invoice_line_ids)"/>
            <table class="table table-sm table-bordered"
                   style="width:100%; table-layout:fixed;
                          page-break-inside: avoid;
                          break-inside: avoid;
                          border-collapse:collapse; font-size:10pt; margin-top:10px !important;margin-bottom:0px !important;">
                <colgroup>
                    <col style="width:25%;"/>
                    <col style="width:25%;"/>
                    <col style="width:25%;"/>
                    <col style="width:25%;"/>
                </colgroup>
                <tbody>
                    <tr>
                        <td rowspan="6"
                            style="text-align:center; vertical-align:middle;">
                            <!-- Replace with your QR code field or image -->
                            <img t-if="o._l10n_sa_is_legal() and o.l10n_sa_qr_code_str"
                        class="d-block"
                        t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s'%('QR', quote_plus(o.l10n_sa_qr_code_str), 200, 200)"/>
                        </td>
                        <td> </td>
                        <td><strong>Amount Before Discount</strong></td>
                        <td class="text-start">
                            <t t-out="gross_amount"
                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                        </td>
                    </tr>
                    <tr>
                        <td></td>
                       <td>Discount </td>
                        <td class="text-start">
                            <t t-out="total_discount"
                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                        </td>
                    </tr>
                     <tr>
                        <td></td>
                       <td>Total(Excl VAT) </td>
                        <td><span t-field="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                    </tr>
                    <tr>
                        <td></td>
                        <td>VAT Amount 15% (SAR)</td>
                        <td><span t-field="o.amount_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                    </tr>
                    <tr>
                        <td></td>
                        <td>Total(Incl VAT)</td>
                        <td><span t-field="o.amount_total"
      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                    </tr>
                    <tr>
                        <td colspan="3">
                           Total in words: SAR <span t-field="o.amount_total_words">Thirty one dollar and Five cents</span></td>
                        </tr>
                </tbody>
            </table>
            <table class="table table-sm table-bordered"
                   style="width:100%; table-layout:fixed;
                          page-break-inside: avoid;
                          break-inside: avoid;
                          border-collapse:collapse; font-size:10pt; margin-top:10px !important;margin-bottom:0px !important;">
                <colgroup>
                    <col style="width:25%;"/>
                    <col style="width:25%;"/>
                    <col style="width:25%;"/>
                    <col style="width:25%;"/>
                </colgroup>
                <tbody>
                    <tr>
                        <td colspan="2"><p>Bank Details</p></td>
                        <td><p>Prepared By</p></td>
                        <td><p>Received By</p></td>
                    </tr>
                    <tr>
                        <td>
                            <span>Account Name</span><br/>
                            <span>إسم الحساب</span>
                        </td>
                        <td>Tricore Trading</td>
                        <td rowspan="4" style="vertical-align:bottom;text-align:center;">
                            <p>Sales Person: <span t-field="o.invoice_user_id"/></p>
                            <span>توقيع مع ختم</span><br/>
                            <span>Signature with Stamp</span>
                        </td>
                        <td rowspan="4" style="vertical-align:bottom;text-align:center">
                            <span>توقيع مع ختم</span><br/>
                            <span>Signature with Stamp</span>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <span>Bank Name</span><br/>
                            <span>اسم البنك</span>
                        </td>
                        <td><t t-if="o.partner_bank_id">
                                <t t-out="o.partner_bank_id.bank_name or ''"/>
                            </t>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <span>Account No.</span><br/>
                            <span>رقم الحساب</span>
                        </td>
                        <td>
                            <t t-if="o.partner_bank_id">
                                <t t-out="o.partner_bank_id.account_number or ''"/>
                            </t>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <span>IBAN No.</span><br/>
                            <span>رقم الآيبان</span>
                        </td>
                        <td>
                            <t t-if="o.partner_bank_id">
                                <t t-out="o.partner_bank_id.iban or ''"/>
                            </t>
                        </td>
                    </tr>
                </tbody>
            </table>
        </xpath>
        <xpath expr="//div[@id='total']" position="replace">
            <div id="total" t-if="False"/>
        </xpath>
    </template>
     <template id="l10n_sa_report_invoice_document_inherit" inherit_id="l10n_sa.l10n_sa_report_invoice_document">
         <xpath expr="//div[@id='total']" position="replace">
            <div id="total" t-if="False"/>
        </xpath>

        <xpath expr="//div[@id='payment_term']" position="replace">
            <div id="payment_term" t-if="False"/>
        </xpath>
    </template>
    <!-- Apply the paper format to the standard invoice report -->
    <template id="custom_report_invoice">
                <t t-call="web.html_container">
                    <t t-foreach="docs" t-as="o">
                        <t t-set="lang" t-value="o.partner_id.lang"/>
                        <t t-call="tricore_custom_addons.report_invoice_document"
               t-lang="lang"/>
                    </t>
                </t>
    </template>
    <template id="custom_report_invoice_with_payments">
            <t t-call="tricore_custom_addons.custom_report_invoice" print_with_payments="True"/>
    </template>
    <record id="account.account_invoices" model="ir.actions.report">
        <field name="paperformat_id"
               ref="tricore_custom_addons.paperformat_compact_header_invoice"/>
        <field name="report_name">tricore_custom_addons.custom_report_invoice_with_payments</field>
    </record>
</odoo>