<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
        <template id="address_layout_inherit" inherit_id="web.address_layout">
            <!-- Make the address column occupy the full row for customer invoices -->
            <xpath expr="//t[@t-set='colclass']" position="attributes">
                <attribute name="t-value">
                    ('col-12')
                </attribute>
            </xpath>
        </template>
        <template id="external_layout_body_inherit" inherit_id="web.external_layout_body">
<!--    hide default layout title-->
             <xpath expr="//h2[@t-out='layout_document_title']"
                   position="attributes">
                <attribute name="t-if">False</attribute>
            </xpath>
    <!--        add new title-->
            <xpath expr="//t[@t-if='customized_address_layout']" position="before">
                <t t-if="layout_document_title">
                    <t t-out="layout_document_title"/>
                </t>
            </xpath>
            <xpath expr="//t[@t-call='web.address_layout']"
               position="attributes">
                 <attribute name="t-call">tricore_custom_addons.address_layout_inherit</attribute>
             </xpath>
        </template>
</odoo>