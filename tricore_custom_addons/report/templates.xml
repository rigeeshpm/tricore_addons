<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
        <template id="address_layout_inherit" inherit_id="web.address_layout">
            <!-- Make the address column occupy the full row for customer invoices -->
            <xpath expr="//t[@t-set='colclass']" position="attributes">
                <attribute name="t-value">
                    ('col-12')
                </attribute>
            </xpath>
        </template>
        <template id="external_layout_body_inherit" inherit_id="web.external_layout_body">
<!--    hide default layout title-->
             <xpath expr="//h2[@t-out='layout_document_title']"
                   position="attributes">
                <attribute name="t-if">False</attribute>
            </xpath>
    <!--        add new title-->
            <xpath expr="//t[@t-if='customized_address_layout']" position="before">
                <t t-if="layout_document_title">
                    <t t-out="layout_document_title"/>
                </t>
            </xpath>
            <xpath expr="//t[@t-call='web.address_layout']"
               position="attributes">
                 <attribute name="t-call">tricore_custom_addons.address_layout_inherit</attribute>
             </xpath>
        </template>
        <template id="custom_external_layout_header"
              inherit_id="web.external_layout_standard" primary="True">
            <xpath expr="//div[contains(@t-attf-class, 'header')]"
                   position="replace">
                <div t-attf-class="o_company_#{company.id}_layout header">
                    <img src="/image_header_main/static/src/img/header.png"
                         alt="Company Header"
                         style="width:100%; max-height:120px; object-fit:contain;"/>
                </div>
            </xpath>
            <xpath expr="//div[contains(@t-attf-class, 'footer')]"
               position="replace">
                <div class="footer o_custom_footer"
                     style="text-align:center;">
                    <img src="/image_footer_main/static/src/img/footer.png"
                         alt="Company Footer"
                         style="width:100%; max-height:100px; object-fit:contain;"/>
                </div>
            </xpath>
        </template>
</odoo>