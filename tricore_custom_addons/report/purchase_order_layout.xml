<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="paperformat_compact_header_purchase" model="report.paperformat">
            <field name="name">Compact Header for custom layouts Invoice</field>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">25</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">30</field>
            <field name="dpi">90</field>
    </record>
    <record id="purchase.action_report_purchase_order" model="ir.actions.report">
        <field name="paperformat_id"
               ref="tricore_custom_addons.paperformat_compact_header_purchase"/>
    </record>
    <record id="purchase.report_purchase_quotation" model="ir.actions.report">
        <field name="paperformat_id"
               ref="tricore_custom_addons.paperformat_compact_header_purchase"/>
    </record>
    <template id="custom_purchase_order_report"
              inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//t[@t-call='web.external_layout']"
               position="attributes">
             <attribute name="t-call">tricore_custom_addons.custom_external_layout_header</attribute>
        </xpath>
<!--        no need to show default title-->
        <xpath expr="//t[@t-set='layout_document_title']" position="replace"/>
<!--        -->
        <xpath expr="//t[@t-set='address']" position="replace"/>
<!--        remove address block-->
        <xpath expr="//t[@t-set='information_block']" position="replace">
            <t t-set="information_block" t-if="o.dest_address_id">
            </t>
        </xpath>
<!--        new information block-->
        <xpath expr="//div[@id='informations']" position="replace">
            <table style="width:100%;
                          border-collapse:collapse;
                          table-layout:fixed;
                          margin-bottom:15px;
                          font-size:11pt;">
                <colgroup>
                    <col style="width:35%;"/>
                    <col style="width:35%;"/>
                    <col style="width:30%;"/>
                </colgroup>
                <!-- FIRST ROW: All cells have full borders -->
                <tr>
                    <td style="border:1px solid #000; padding:5px;">
                        <strong>PURCHASE ORDER</strong>
                    </td>
                    <td style="border:1px solid #000; padding:5px;">
                        <strong>Doc # <span t-field="o.name"/> </strong>
                    </td>
                    <td style="border:1px solid #000; padding:5px;">
                         <strong>Date: <span t-field="o.date_approve" t-options='{"widget": "date"}'/></strong>
                    </td>
                </tr>
                <!-- SECOND ROW: Column partitions only, no row partitions -->
                <tr>
                    <td style="border-right: 1px solid #000; border-top: none; border-bottom: none; border-left:1px solid #000 ; padding:3px;">
                        <span><b>Bill To: </b><span t-field="o.partner_id"/> </span>
                    </td>
                    <td style="border-right: 1px solid #000; border-top: none; border-bottom: none; border-left:1px solid #000; padding:3px;">
                        <span><b>Payment Term:</b> <span t-field="o.payment_term_id"/></span>
                    </td>
                    <td style="border-right: 1px solid #000; border-top: none; border-bottom: none; border-left:1px solid #000;padding:3px;">
                        <span><b>ETD: </b><span t-field="o.date_planned" t-options='{"widget": "date"}'/></span>
                    </td>
                </tr>
                <!-- THIRD ROW -->
                <tr>
                    <td style="border-right: 1px solid #000; border-top: none; border-bottom: none; border-left:1px solid #000;padding:3px;">
                        <span><b>Attn: </b><span t-field="o.user_id"/> </span>
                    </td>
                    <td style="border-right: 1px solid #000; border-top: none; border-bottom: none; border-left:1px solid #000;padding:3px;">
                        <span><b>Delivery Term:</b><span t-field="o.incoterm_id"/> </span>
                    </td>
                    <td style="border-right: 1px solid #000; border-top: none; border-bottom: none; border-left:1px solid #000;padding:3px;">
                        <span><b>Currency:</b> <span t-field="o.company_id.currency_id"/> </span>
                    </td>
                </tr>
                <!-- FOURTH ROW -->
                <tr>
                    <td style="border-right: 1px solid #000; border-top: none; border-bottom:1px solid #000; border-left:1px solid #000;padding:3px;">
                        <span><b>VAT: <span t-field="o.partner_id.vat"/></b> </span>
                    </td>
                    <td style="border-right: 1px solid #000; border-top: none; border-bottom:1px solid #000; border-left:1px solid #000;padding:3px;">
                        <span><b>Place of Supply:</b> <span t-field="o.partner_id.state_id"/> , <span t-field="o.partner_id.country_id"/> </span>
                    </td>
                    <td style="border-right: 1px solid #000; border-top: none; border-bottom:1px solid #000; border-left:1px solid #000;padding:3px;">
                        <span><b>Validity:</b> <span t-field="o.date_promised" t-options='{"widget": "date"}'/> </span>
                    </td>
                </tr>
            </table>
        </xpath>
<!--        purchase lines table -->
        <xpath expr="//table[hasclass('o_main_table')]"
               position="attributes">
            <attribute name="class" add="sales-lines-cell-borders" separator=" "/>
        </xpath>
        <xpath expr="//table[hasclass('o_main_table')]/thead" position="replace">
            <thead>
                <tr>
                     <th name="th_si_no"
                        style="width: 5% !important; min-width: 5% !important; max-width: 5% !important; white-space: nowrap;">
                        <span>#</span>
                        <t t-set="line_index" t-value="0"/>
                    </th>
                    <th name="th_item_code"
                        style="min-width: 100px !important;max-width: 100px !important; white-space: nowrap;">
                        <span>Item Code</span>
                    </th>
                    <th name="th_description" style="text-align: left; width: 40%; padding: 8px;" class="text-start"><strong>Description</strong></th>
                     <th name="th_quantity" class="text-end"><strong>Qty/UOM</strong></th>
                    <th name="th_price_unit" class="text-end"><strong>Unit Price</strong></th>
                    <th name="th_gross_total" class="text-end">
                        <strong>Gross Amount</strong>
                    </th>
                    <th name="th_taxes" class="text-end"><strong>Taxes</strong></th>
                    <th name="th_subtotal" class="text-end">
                                <strong>Net Amount</strong>
                    </th>
                </tr>
            </thead>
        </xpath>
        <xpath expr="//td[@id='product']" position="before">
            <td name="si_no" t-att-style="padding_style">
                <t t-set="line_index" t-value="line_index+1"/>
                <t t-out="line_index"/>
            </td>
            <td name="product_code" style="min-width:100px !important">
             <span  t-field="line.product_id.default_code"/>
            </td>
        </xpath>
          Add Gross Total header before Discount
        <!-- Add Gross Total value before Discount -->
        <xpath expr="//td[span/span[@t-field='line.discount']]" position="before">
            <td name="td_gross_total" class="text-end">
                <span t-out="line.price_unit * line.product_qty"
                      t-options="{'widget': 'monetary',
                                  'display_currency': o.currency_id}"/>
            </td>
        </xpath>
        <xpath expr="//td[.//span[@t-field='line.price_subtotal']]" position="replace">
            <td name="td_net_amount" class="text-end">
                <span t-out="line.price_unit * line.product_qty *(1- line.discount/100)"
                      t-options="{'widget': 'monetary',
                                  'display_currency': o.currency_id}"/>
            </td>
        </xpath>
<!--        <xpath expr="//th[@name='th_discount']" position="replace"/>-->
        <xpath expr="//td[span/span[@t-field='line.discount']]" position="replace"/>
<!--purchase order table end-->
        <xpath expr="//t[@t-if='o.payment_term_id']" position="replace"/>
        <xpath expr="//p[@t-field='o.note']" position="replace"/>
        <!-- Replace the existing totals section with the custom footer -->
        <xpath expr="//div[@id='total']" position="replace">
            <div id="total" class="row"
                 style="font-size: 13px;">
                <!-- LEFT SECTION -->
                <div class="col-7">
                    <!-- Amount in Words -->
                    <div class="row mb-4">
                        <div class="col-5">
                            <strong>Total Amount In Words : </strong>
                        </div>
                        <div class="col-7">
                            <span t-field="o.currency_id"/>
                            <span t-out="o.currency_id.amount_to_text(o.amount_total)"/>
                        </div>
                    </div>
                    <!-- Narration -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <strong>Narration :</strong>
                        </div>
                    </div>
                </div>
                <!-- RIGHT SECTION -->
                <div class="col-5">
                    <!-- Amount Summary -->
                    <div class="row">
                        <div class="col-2"/>
                        <div class="col-5">
                            <table class="table table-sm"
                                   style="border: 1px solid black;
                                          margin-bottom: 10px;">
                                <tbody>
                                    <tr>
                                        <td style="border: 1px solid black;
                                                   padding: 8px;">
                                            Sub Total
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid black;
                                                   padding: 8px;">
                                            Discount
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid black;
                                                   padding: 8px;">
                                            Total
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid black;
                                                   padding: 8px;">
                                            VAT
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid black;
                                                   padding: 8px;">
                                            <strong>Grand Total</strong>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="col-1"/>
                        <div class="col-4">
                            <t t-set="discount_total"
       t-value="sum(line.price_unit * line.product_qty * (line.discount or 0.0) / 100.0 for line in o.order_line if not line.display_type)"/>
                            <t t-set="gross_subtotal"
       t-value="sum(line.price_unit * line.product_qty for line in o.order_line if not line.display_type)"/>
                            <table class="table table-sm text-end"
                                   style="border: 1px solid black;
                                          margin-bottom: 10px;">
                                <tbody>
                                    <tr>
                                        <td style="border: 1px solid black;
                                                   padding: 8px;">
                                            <span t-out="gross_subtotal"
                                                  t-options="{'widget': 'monetary',
                                                  'display_currency': o.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid black;
                                                   padding: 8px;">
                                             <span t-out="discount_total"
                                                  t-options="{'widget': 'monetary',
                                                  'display_currency': o.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid black;
                                                   padding: 8px;">
                                            <span t-field="o.amount_untaxed"
                                                  t-options="{'widget': 'monetary',
                                                  'display_currency': o.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid black;
                                                   padding: 8px;">
                                            <span t-field="o.amount_tax"
                                                  t-options="{'widget': 'monetary',
                                                  'display_currency': o.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid black;
                                                   padding: 8px;">
                                            <strong>
                                                <span t-field="o.amount_total"
                                                      t-options="{'widget': 'monetary',
                                                      'display_currency': o.currency_id}"/>
                                            </strong>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div id="signature" class="row"
                 style="font-size: 13px;margin-top:3px">
                <t t-set="primary_color" t-value="o.company_id.primary_color or '#000000'"/>
                <table class="table-borderless">
                    <tr style="border:none !important">
                        <td style="border:none !important;vertical-align:bottom;width:50% !important">
                            <strong>Terms &amp; Conditions</strong>
                            <span t-field="o.note"/>
                        </td>
                        <td style="border:none !important;vertical-align:bottom;width:40% !important">
                            <div class="row mt-2" t-attf-style="border: 1px solid #{primary_color}; min-height: 200px;
                                    text-align: center;">
                               <div class="col-4"  t-attf-style="border-right: 1px solid #{primary_color}; padding-top: 210px;">
                                    <div style="border-top: 1px solid black;
                                                margin: 0 10px;
                                                padding-top: 5px;">
                                        <strong>Prepared By</strong>
                                    </div>
                                </div>
                                <div class="col-4" t-attf-style="border-right: 1px solid #{primary_color}; padding-top: 210px;">
                                    <div style="border-top: 1px solid black;
                                                margin: 0 10px;
                                                padding-top: 5px;">
                                        <strong>Verify By</strong>
                                    </div>
                                </div>
                                <div class="col-4"
                                     style="padding-top: 210px;">
                                    <div style="border-top: 1px solid black;
                                                margin: 0 10px;
                                                padding-top: 5px;">
                                        <strong>Approved By</strong>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </xpath>
    </template>
</odoo>