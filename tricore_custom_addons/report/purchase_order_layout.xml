<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="paperformat_compact_header_purchase" model="report.paperformat">
            <field name="name">Compact Header for custom layouts Invoice</field>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">25</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">30</field>
            <field name="dpi">90</field>
    </record>
    <record id="purchase.action_report_purchase_order" model="ir.actions.report">
        <field name="paperformat_id"
               ref="tricore_custom_addons.paperformat_compact_header_purchase"/>
    </record>
    <record id="purchase.report_purchase_quotation" model="ir.actions.report">
        <field name="paperformat_id"
               ref="tricore_custom_addons.paperformat_compact_header_purchase"/>
    </record>

    <template id="custom_purchase_order_report"
              inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//t[@t-call='web.external_layout']"
               position="attributes">
             <attribute name="t-call">tricore_custom_addons.custom_external_layout_header</attribute>
        </xpath>
        <xpath expr="//t[@t-set='layout_document_title']" position="replace"/>
        <xpath expr="//t[@t-set='address']" position="replace"/>
        <xpath expr="//t[@t-set='information_block']" position="replace">
            <t t-set="information_block" t-if="o.dest_address_id">
            </t>
        </xpath>
        <xpath expr="//div[@id='informations']" position="replace">
            <table style="100%;margin-left:0px !important;margin-right:0px !important">
                <tr>
                    <td style="border-right:1px solid black;padding-right:3px">
                        <div style="padding:2px;border:1px solid black">
                            <b>PURCHASE ORDER</b>
                        </div>
                    </td>
                    <td  style="padding-left:3px;padding-right:3px">
                         <div style="padding:2px;border:1px solid black">
                            <span>Doc # <span t-field="o.name"/></span>
                        </div>

                    </td>
                    <td style="padding-left:3px;border-left:1px solid black">
                        <div style="padding:2px;border:1px solid black">
                           <span>Date<span t-field="o.date_approve"/></span>
                        </div>

                    </td>
                </tr>
                <tr>
                    <td style="border-right:1px solid black;padding-right:3px">
                        <span><b>Bill To: </b><span t-field="o.partner_id"/> </span>
                    </td>
                    <td><span>Payment Term</span></td>
                    <td style="padding-left:3px;border-left:1px solid black"><span>ETD</span></td>
                </tr>
                <tr>
                    <td style="border-right:1px solid black;padding-right:3px"><span>Attn</span></td>
                    <td><span>Delivery Term</span></td>
                    <td style="padding-left:3px;border-left:1px solid black"><span>Currency</span></td>
                </tr>
                <tr>
                    <td style="border-right:1px solid black;padding-right:3px"><span>TRN</span></td>
                    <td><span>Place of Supply</span></td>
                    <td style="padding-left:3px;border-left:1px solid black"><span>Validity</span></td>
                </tr>
            </table>
        </xpath>
        <xpath expr="//table[hasclass('o_main_table')]"
               position="attributes">
            <attribute name="class" add="sales-lines-cell-borders" separator=" "/>
        </xpath>
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_si_no"
                style="width: 7% !important; min-width: 7% !important; max-width: 7% !important; white-space: nowrap;"
                t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span>#</span>
                <t t-set="line_index" t-value="0"/>
            </th>
            <th name="th_name"
                style="min-width: 200px !important; white-space: nowrap;"
                t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span>Item</span>
            </th>
        </xpath>
        <xpath expr="//td[@id='product']" position="before">
            <td name="si_no" t-att-style="padding_style">
                <t t-set="line_index" t-value="line_index+1"/>
                <t t-out="line_index"/>
            </td>
            <td name="product_code" style="min-width:200px !important">
             <span  t-field="line.product_id.default_code"/>
            </td>
        </xpath>
          Add Gross Total header before Discount
    <xpath expr="//th[@name='th_discount']" position="before">
        <th name="th_gross_total" class="text-end">
            <strong>Gross Total</strong>
        </th>
    </xpath>

    <!-- Add Gross Total value before Discount -->
    <xpath expr="//td[span/span[@t-field='line.discount']]" position="before">
        <td name="td_gross_total" class="text-end">
            <span t-out="line.price_unit * line.product_qty"
                  t-options="{'widget': 'monetary',
                              'display_currency': o.currency_id}"/>
        </td>
    </xpath>

    <!-- Replace the existing totals section with the custom footer -->
    <xpath expr="//div[@id='total']" position="replace">
        <div id="total" class="row mt-3"
             style="font-size: 13px;">
            <!-- LEFT SECTION -->
            <div class="col-7">
                <!-- Amount in Words -->
                <div class="row mb-4">
                    <div class="col-5">
                        <strong>Total Amount In Words : </strong>
                    </div>
                    <div class="col-7">
                        <span t-field="o.currency_id"/>
                        <span t-out="o.currency_id.amount_to_text(o.amount_total)"/>
                    </div>
                </div>
                <!-- Narration -->
                <div class="row mb-4">
                    <div class="col-12">
                        <strong>Narration :</strong>
                    </div>
                </div>
                <!-- Terms and Conditions -->
                <div class="mt-5">
                    <div class="mb-1">
                        <strong>Terms &amp; Conditions</strong>
                    </div>
                    <ul style="padding-left: 15px; margin-bottom: 0;">
                        <li>
                            All request delivery dates refer to the receiving
                            of the goods at Tricore Trading or the mention
                            place of delivery.
                        </li>

                        <li>
                            Invoice and delivery notes must refer to our
                            purchase order number and sent to our finance
                            department / finance@tricore.com within
                            5 working days.
                        </li>

                        <li>
                            Invoice addressed incorrectly will not be
                            considered for payment processing.
                        </li>

                        <li>
                            Invoice date cannot be earlier than the delivery
                            date. Also attach the copy of delivery note duly
                            signed by an authorized person.
                        </li>

                        <li>
                            Please notify us immediately if you are unable
                            to ship as specified. We reserve the right to
                            cancel the order if the delivery is delayed
                            above the agreed date.
                        </li>

                        <li>
                            Quantity &amp; items delivered other than those
                            specified above either will not be accepted by
                            us or will be returned to the vendor. All
                            transportation, freight and other incidental
                            cost related to the returned material will be
                            borne by the vendor.
                        </li>
                    </ul>
                </div>
            </div>

            <!-- RIGHT SECTION -->
            <div class="col-5">
                <!-- Amount Summary -->
                <div class="row">
                    <div class="col-2"/>
                    <div class="col-5">
                        <table class="table table-sm"
                               style="border: 1px solid black;
                                      margin-bottom: 10px;">
                            <tbody>
                                <tr>
                                    <td style="border: 1px solid black;
                                               padding: 8px;">
                                        Sub Total
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid black;
                                               padding: 8px;">
                                        Discount
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid black;
                                               padding: 8px;">
                                        Total
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid black;
                                               padding: 8px;">
                                        VAT
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid black;
                                               padding: 8px;">
                                        <strong>Grand Total</strong>
                                    </td>
                                </tr>

                            </tbody>

                        </table>
                    </div>
                    <div class="col-1"/>
                    <div class="col-4">
                        <t t-set="discount_total"
   t-value="sum(line.price_unit * line.product_qty * (line.discount or 0.0) / 100.0 for line in o.order_line if not line.display_type)"/>
                        <t t-set="gross_subtotal"
   t-value="sum(line.price_unit * line.product_qty for line in o.order_line if not line.display_type)"/>
                        <table class="table table-sm text-end"
                               style="border: 1px solid black;
                                      margin-bottom: 10px;">
                            <tbody>
                                <tr>
                                    <td style="border: 1px solid black;
                                               padding: 8px;">
                                        <span t-out="gross_subtotal"
                                              t-options="{'widget': 'monetary',
                                              'display_currency': o.currency_id}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid black;
                                               padding: 8px;">
                                         <span t-out="discount_total"
                                              t-options="{'widget': 'monetary',
                                              'display_currency': o.currency_id}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid black;
                                               padding: 8px;">
                                        <span t-field="o.amount_untaxed"
                                              t-options="{'widget': 'monetary',
                                              'display_currency': o.currency_id}"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="border: 1px solid black;
                                               padding: 8px;">
                                        <span t-field="o.amount_tax"
                                              t-options="{'widget': 'monetary',
                                              'display_currency': o.currency_id}"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="border: 1px solid black;
                                               padding: 8px;">
                                        <strong>
                                            <span t-field="o.amount_total"
                                                  t-options="{'widget': 'monetary',
                                                  'display_currency': o.currency_id}"/>
                                        </strong>
                                    </td>
                                </tr>

                            </tbody>

                        </table>
                    </div>

                </div>


                <!-- Signature Section -->
                <div class="row mt-2"
                     style="border: 1px solid black;
                            min-height: 200px;
                            text-align: center;">

                    <div class="col-4"
                         style="border-right: 1px solid black;
                                padding-top: 180px;">

                        <div style="border-top: 1px solid black;
                                    margin: 0 10px;
                                    padding-top: 5px;">
                            <strong>Prepared By</strong>
                        </div>

                    </div>

                    <div class="col-4"
                         style="border-right: 1px solid black;
                                padding-top: 180px;">

                        <div style="border-top: 1px solid black;
                                    margin: 0 10px;
                                    padding-top: 5px;">
                            <strong>Verify By</strong>
                        </div>

                    </div>

                    <div class="col-4"
                         style="padding-top: 180px;">

                        <div style="border-top: 1px solid black;
                                    margin: 0 10px;
                                    padding-top: 5px;">
                            <strong>Approved By</strong>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </xpath>
    </template>

</odoo>