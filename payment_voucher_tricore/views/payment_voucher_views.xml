<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mx_payment_voucher_tree" model="ir.ui.view">
        <field name="name">mx.payment.voucher.tree</field>
        <field name="model">mx.payment.voucher</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" required="1"/>
                <field name="account_id"/>
                <field name="voucher_date"/>
                <field name="state"/>
                <field name="narration"/>
            </list>
        </field>
    </record>

        <record id="mx_payment_voucher_form" model="ir.ui.view">
        <field name="name">mx.payment.voucher.form</field>
        <field name="model">mx.payment.voucher</field>
        <field name="arch" type="xml">
            <form string="Payment Voucher Form">
                <header>
                    <button name="action_draft" type="object" string="Reset to Draft" groups="account.group_account_invoice" invisible="state != 'post'"/>
                    <button name="post_journal" string="Post" type="object" groups="account.group_account_invoice" class="oe_highlight" invisible="state != 'draft'" data-hotkey="v"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,post"/>
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button class="oe_stat_button" invisible="state != 'post'" name="view_journal_entry" type="object" icon="fa-bars" string="Journal Entry"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group name="cust_voucher main">
                        <group name="cust_voucher_child">
<!--                            <field name="voucher_type" required="1" widget='radio' attrs="{'readonly': [('state', 'in', ('posted','cancelled'))]}" options="{'horizontal': true}"/>-->
                            <field name="account_id" required="1" readonly="state in ['post', 'cancel']" options="{'no_create': True, 'no_create_edit':True}"/>
                            <field name="narration" readonly="state in ['post', 'cancel']"/>
                        </group>
                        <group>
                            <field name="voucher_date" required="1" readonly="state in ['post', 'cancel']" />
                            <field name="journal_id" required="1" readonly="state in ['post', 'cancel']"  options="{'no_create': True, 'no_create_edit':True}"/>
                        </group>
                    </group>
                    <notebook name="voucher_tab">
                        <page name="voucher_page" string="Voucher Details">
                            <field name="voucher_line_ids">
                                  <list string="Voucher" editable="bottom">
                                      <field name="account_id" options="{'no_create': True, 'no_create_edit':True}" string="Account"/>
                                      <field name="partner_id" options="{'no_create': True, 'no_create_edit':True}" />
                                      <field name="narration" />
                                      <field name="tax" options="{'no_create': True, 'no_create_edit':True}"/>
                                      <field name="analytic_distribution" widget="analytic_distribution"/>
                                      <field name="amount"/>
                                      <field name='tax_amount'/>
                                  </list>
                            </field>
                            <group name="note_group" col="6" class="mt-2 mt-md-0">
                                <group class="oe_subtotal_footer oe_right" colspan="2" name="sale_total">
                                    <field name="company_id"  colspan="2" invisible="1"/>
                                    <field name="currency_id"  colspan="2" invisible="1"/>
                                    <field name="untaxed_amount"  colspan="2" widget='monetary'/>
                                    <field name="tax"  colspan="2" widget='monetary'/>
                                    <field name="total"  colspan="2" widget='monetary'/>
                                </group>
                                <div class="oe_clear"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>

        </field>
    </record>

    <record id="payment_voucher_menu_action" model="ir.actions.act_window">
        <field name="name">Payment Voucher</field>
        <field name="res_model">mx.payment.voucher</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem name="Vouchers" id="mx_voucher_menu"
          parent="account.menu_finance_entries"
          sequence="10"
          groups="account.group_account_readonly"/>
    <menuitem name="Payment Voucher" id="mx_payment_voucher_menu" action="payment_voucher_menu_action" sequence="1" parent="mx_voucher_menu"
    groups="account.group_account_readonly"/>

</odoo>